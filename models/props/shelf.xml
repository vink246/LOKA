<mujoco model="shelf">
  <!-- The bookshelf from HumanoidBench tasks/room.xml (MIT, see LICENSE.humanoidbench),
       0.65 x 0.9 x 1.85 m with its open side facing -x. The body origin is on the
       floor. LOKA keeps it static (no free joint), as a wall-like landmark. -->
  <default>
    <default class="visual">
      <geom group="2" contype="0" conaffinity="0" density="0"/>
    </default>
    <default class="collision">
      <geom group="3"/>
    </default>
  </default>
  <asset>
    <texture name="light_wood" type="2d" file="textures/light-wood.png"/>
    <material name="wooden_cover" texture="light_wood" texuniform="false"/>
  </asset>
  <worldbody>
    <body name="shelf">
      <geom type="box" pos="0 0 0.025" size="0.3 0.4 0.025" material="wooden_cover" class="visual"/>
      <geom type="box" pos="0 0 0.325" size="0.3 0.4 0.025" material="wooden_cover" class="visual"/>
      <geom type="box" pos="0 0 0.625" size="0.3 0.4 0.025" material="wooden_cover" class="visual"/>
      <geom type="box" pos="0 0 0.925" size="0.3 0.4 0.025" material="wooden_cover" class="visual"/>
      <geom type="box" pos="0 0 1.225" size="0.3 0.4 0.025" material="wooden_cover" class="visual"/>
      <geom type="box" pos="0 0 1.525" size="0.3 0.4 0.025" material="wooden_cover" class="visual"/>
      <geom type="box" pos="0.025 0 1.825" size="0.325 0.45 0.025" material="wooden_cover" class="visual"/>
      <geom type="box" pos="0.025 0.425 0.9" size="0.325 0.025 0.9" material="wooden_cover" class="visual"/>
      <geom type="box" pos="0.025 -0.425 0.9" size="0.325 0.025 0.9" material="wooden_cover" class="visual"/>
      <geom type="box" pos="0.325 0 0.9" size="0.025 0.4 0.9" material="wooden_cover" class="visual"/>

      <geom type="box" pos="0 0 0.025" size="0.3 0.4 0.025" class="collision"/>
      <geom type="box" pos="0 0 0.325" size="0.3 0.4 0.025" class="collision"/>
      <geom type="box" pos="0 0 0.625" size="0.3 0.4 0.025" class="collision"/>
      <geom type="box" pos="0 0 0.925" size="0.3 0.4 0.025" class="collision"/>
      <geom type="box" pos="0 0 1.225" size="0.3 0.4 0.025" class="collision"/>
      <geom type="box" pos="0 0 1.525" size="0.3 0.4 0.025" class="collision"/>
      <geom type="box" pos="0.025 0 1.825" size="0.325 0.45 0.025" class="collision"/>
      <geom type="box" pos="0.025 0.425 0.9" size="0.325 0.025 0.9" class="collision"/>
      <geom type="box" pos="0.025 -0.425 0.9" size="0.325 0.025 0.9" class="collision"/>
      <geom type="box" pos="0.325 0 0.9" size="0.025 0.4 0.9" class="collision"/>
    </body>
  </worldbody>
</mujoco>
