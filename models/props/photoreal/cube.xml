<mujoco model="cube_photoreal">
  <!-- Photoreal pool also needs cube; reuse dark wood. -->
  <default>
    <default class="visual">
      <geom group="2" contype="0" conaffinity="0" density="0"/>
    </default>
    <default class="collision">
      <geom group="3"/>
    </default>
  </default>
  <asset>
    <texture name="cube_wood" type="2d" file="../../room/textures/dark_wood_diff_512.png"/>
    <material name="cube_wood" texture="cube_wood" texuniform="true"/>
  </asset>
  <worldbody>
    <body name="cube">
      <geom type="box" pos="0 0 0.1" size="0.1 0.1 0.1" material="cube_wood" class="visual"/>
      <geom name="block" type="box" pos="0 0 0.1" size="0.1 0.1 0.1" mass="0.3" class="collision"/>
    </body>
  </worldbody>
</mujoco>
