<mujoco model="g1_29dof stand scene">
  <include file="g1_29dof.xml"/>

  <!-- Elliptic cone + high impratio gives realistic (non-slipping) foot friction,
       which the WBC's friction-cone constraints assume. -->
  <option timestep="0.001" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <statistic center="0 0 0.5" extent="1.6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1" force="1 0.2 0.1 0.8"/>
    <map force="0.003"/>
    <scale forcewidth="0.03" contactwidth="0.06" contactheight="0.02"/>
    <global azimuth="130" elevation="-15" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
      friction="1.0 0.02 0.001"/>
    <!-- Side camera for R-key video capture; tracks the robot CoM. -->
    <camera name="side_follow" pos="0 -2.8 0.7" xyaxes="1 0 0 0 0 1"
      mode="trackcom" fovy="45"/>
  </worldbody>

  <keyframe>
    <!-- Nominal stand. Three properties are deliberate and worth keeping if
         you retune this pose:
           * knees bent, staying clear of the straight-leg singularity where
             the whole-body QP loses vertical authority;
           * soles exactly flat on the floor at this pelvis height;
           * legs pitched forward ~0.0176 rad from vertical so the CoM lands on
             the middle of the sole rather than 9 mm behind it, which is what
             equalises the forward and backward push margins.
         qpos = [pelvis xyz, quat wxyz, 29 joints]. -->
    <key name="stand"
      qpos="0 0 0.77785
            1 0 0 0
            -0.18237 0 0 0.42 -0.23763 0
            -0.18237 0 0 0.42 -0.23763 0
            0 0 0
            0 0.20 0 0.90 0 0 0
            0 -0.20 0 0.90 0 0 0"/>
  </keyframe>
</mujoco>
