<mujoco model="g1_29dof nav photoreal">
  <!-- Same G1 plant as scene.xml, with MP3D-matched indoor materials for the
       navigation_photoreal eval (Poly Haven CC0; see models/room/LICENSE.polyhaven).
       Floor: wooden_floor_01 at texrepeat 1 (1 m period) so plank runs read under Phong. -->
  <include file="g1_29dof.xml"/>

  <option timestep="0.001" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <statistic center="0 0 0.5" extent="1.6"/>

  <visual>
    <!-- Low specular: classic OpenGL otherwise mirrors the skybox on the wood floor. -->
    <headlight diffuse="0.85 0.82 0.78" ambient="0.50 0.48 0.45" specular="0 0 0"/>
    <rgba haze="0.70 0.68 0.64 1" force="1 0.2 0.1 0.8"/>
    <map force="0.003"/>
    <scale forcewidth="0.03" contactwidth="0.06" contactheight="0.02"/>
    <global azimuth="130" elevation="-15" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <!-- Soft indoor void instead of blue outdoor sky. -->
    <texture type="skybox" builtin="gradient" rgb1="0.78 0.74 0.70" rgb2="0.35 0.33 0.30"
      width="512" height="3072"/>
    <texture type="2d" name="groundplane" file="../room/textures/wooden_floor_01_diff_1k.png"/>
    <texture type="2d" name="wall_plaster" file="../room/textures/plastered_wall_diff_1k.png"/>
    <texture type="2d" name="ceiling_plaster" file="../room/textures/plastered_wall_diff_1k.png"/>
    <!-- texrepeat 1 => one Poly Haven tile per metre (source tile is 2 m; denser so
         plank runs read under Phong). floor_cell_size = 1.0. reflectance 0 avoids
         mirror-floor washout in the classic renderer. -->
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="1 1"
      reflectance="0"/>
    <material name="wall_plaster" texture="wall_plaster" texuniform="true" texrepeat="1.5 1.5"
      rgba="1 1 1 1"/>
    <material name="ceiling_plaster" texture="ceiling_plaster" texuniform="true" texrepeat="1 1"
      rgba="0.95 0.94 0.92 1"/>
  </asset>

  <worldbody>
    <!-- Warm overhead fill; specular kept low so albedo textures dominate. -->
    <light name="room_key" pos="2.5 0.2 3.2" dir="-0.15 0 -1" diffuse="1.0 0.95 0.85"
      specular="0.02 0.02 0.02" directional="true"/>
    <light name="room_fill" pos="1.0 -1.5 2.8" dir="0.2 0.3 -1" diffuse="0.55 0.53 0.50"
      specular="0 0 0" directional="true"/>
    <!-- rgba 1: geom tint multiplies the material; 0.5 crushed wood grain. -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" rgba="1 1 1 1"
      friction="1.0 0.02 0.001" priority="1"/>
    <camera name="side_follow" pos="0 -2.8 0.7" xyaxes="1 0 0 0 0 1"
      mode="trackcom" fovy="45"/>
  </worldbody>

  <keyframe>
    <key name="stand"
      qpos="0 0 0.77785
            1 0 0 0
            -0.18237 0 0 0.42 -0.23763 0
            -0.18237 0 0 0.42 -0.23763 0
            0 0 0
            0 0.20 0 0.90 0 0 0
            0 -0.20 0 0.90 0 0 0"/>
  </keyframe>
</mujoco>
